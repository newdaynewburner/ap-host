[Unit]
Description=Access point host for rouge access point
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=com.aphost.APHost
ExecStart=/usr/sbin/aphostd /etc/rouge-access-point/components/ap-host.ini
Restart=on-failure
User=root
Group=root

[Install]
WantedBy=multi-user.target
